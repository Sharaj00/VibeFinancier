<resources>
    <style name="DrawerAnimation"><item name="android:windowEnterAnimation">@anim/drawer_enter</item><item name="android:windowExitAnimation">@anim/drawer_exit</item></style>
    <style name="WidgetOverlayTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowIsTranslucent">true</item><item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item><item name="android:windowActionModeOverlay">true</item><item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowDisablePreview">true</item><item name="android:colorAccent">#8BC9B7</item>
        <item name="android:windowAnimationStyle">@null</item>
    </style>
    <style name="WidgetPopupAnimation"><item name="android:windowEnterAnimation">@anim/widget_popup_enter</item><item name="android:windowExitAnimation">@anim/widget_popup_exit</item></style>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#146C60</item>
        <item name="android:windowLightStatusBar">true</item><item name="android:statusBarColor">#F5F7F5</item>
        <item name="android:navigationBarColor">#F5F7F5</item>
        <item name="android:windowActionModeOverlay">true</item><item name="android:windowBackground">#F5F7F5</item>
    </style>
    <style name="QuickTheme" parent="android:style/Theme.Material.Light.Dialog.NoActionBar.MinWidth">
        <item name="android:colorAccent">#146C60</item><item name="android:windowSoftInputMode">adjustResize</item>
    </style>
    <style name="DarkTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item><item name="android:colorAccent">#8BC9B7</item><item name="android:windowBackground">#121212</item><item name="android:colorBackground">#121212</item><item name="android:colorBackgroundFloating">#222222</item><item name="android:statusBarColor">#252525</item><item name="android:navigationBarColor">#121212</item><item name="android:windowLightStatusBar">false</item>
    </style>
    <style name="OledTheme" parent="DarkTheme"><item name="android:windowBackground">#000000</item><item name="android:colorBackground">#000000</item><item name="android:colorBackgroundFloating">#000000</item><item name="android:statusBarColor">#000000</item><item name="android:navigationBarColor">#000000</item></style>
    <style name="DarkQuickTheme" parent="android:style/Theme.Material.Dialog.NoActionBar.MinWidth"><item name="android:colorAccent">#8BC9B7</item><item name="android:windowBackground">#121212</item></style>
    <style name="OledQuickTheme" parent="DarkQuickTheme"><item name="android:windowBackground">#000000</item><item name="android:colorBackground">#000000</item><item name="android:colorBackgroundFloating">#000000</item></style>
</resources>
